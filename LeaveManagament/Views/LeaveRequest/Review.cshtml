@model LeaveRequestReviewVM

@{
    ViewData["Title"] = "Review Leave Request";
    var isPending = Model.Status == LeaveManagament.Data.LeaveRequestStatus.Pending;
}

<h1>@(isPending ? "Review Leave Request" : "Leave Request Details")</h1>
<hr />

<dl class="row">
    <dt class="col-sm-3">Employee</dt>
    <dd class="col-sm-9">@Model.EmployeeName (@Model.EmployeeEmail)</dd>

    <dt class="col-sm-3">Leave Type</dt>
    <dd class="col-sm-9">@Model.LeaveTypeName</dd>

    <dt class="col-sm-3">Dates</dt>
    <dd class="col-sm-9">
        @Model.StartDate.ToString("dd MMM yyyy") &ndash; @Model.EndDate.ToString("dd MMM yyyy")
        (@Model.NumberOfDays day(s))
    </dd>

    <dt class="col-sm-3">Requested On</dt>
    <dd class="col-sm-9">@Model.DateRequested.ToString("dd MMM yyyy HH:mm")</dd>

    <dt class="col-sm-3">Employee Comments</dt>
    <dd class="col-sm-9">@Model.RequestComments</dd>

    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9"><partial name="_LeaveRequestStatus" model="Model.Status" /></dd>

    @if (!isPending)
    {
        <dt class="col-sm-3">Reviewed By</dt>
        <dd class="col-sm-9">@Model.ReviewerName</dd>

        <dt class="col-sm-3">Reviewer Comments</dt>
        <dd class="col-sm-9">@Model.ReviewComments</dd>
    }
</dl>

@if (isPending)
{
    <div class="row">
        <div class="col-md-5">
            <form asp-action="Review" asp-route-id="@Model.Id" method="post">
                <div class="form-group">
                    <label for="reviewComments" class="control-label">Reviewer Comments</label>
                    <textarea id="reviewComments" name="reviewComments" class="form-control" rows="3"></textarea>
                </div>
                <div class="form-group mt-3">
                    <button type="submit" name="approved" value="true" class="btn btn-success">Approve</button>
                    <button type="submit" name="approved" value="false" class="btn btn-danger">Reject</button>
                    <a asp-action="ListRequests" class="btn btn-primary">Back to List</a>
                </div>
            </form>
        </div>
    </div>
}
else
{
    <a asp-action="ListRequests" class="btn btn-primary">Back to List</a>
}
